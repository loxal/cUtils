# Copyright 2026 Alexander Orlov <alexander.orlov@loxal.net>
#
# bitwarden-dedup — task runner
#
# Six binaries:
#
# JSON-path tools (offline; consume a Bitwarden JSON export):
#   * bitwarden-dedup                 — deduplicate a real export into an
#                                       import-ready file
#   * bitwarden-merge-icloud          — merge an Apple Passwords CSV into a
#                                       Bitwarden JSON
#   * bitwarden-move-to-folder        — move every item into a single folder,
#                                       leaving the export's other shape intact
#   * bitwarden-redact                — produce a local reviewer-shareable
#                                       redacted replica of a real export (NOT
#                                       committable; output still carries
#                                       vault-shape metadata and is gitignored)
#
# REST-API tools (talk to bitwarden.com / .eu over rustls; require the personal
# API key in vault/bitwarden_api_key.env):
#   * bitwarden-backup-vault-encrypted — encrypted backup, no master password.
#                                        Writes the raw /api/sync response to
#                                        vault/bitwarden_encrypted-export_<ts>.json.
#   * bitwarden-backup-vault-decrypted — decrypted backup, prompts for master
#                                        password. Writes a `just dedup`-ready
#                                        JSON to vault/bitwarden_decrypted-export_<ts>.json.
#                                        Crypto correctness gated on
#                                        tests/crypto_vectors.rs (byte-locked
#                                        against bitwarden/sdk-internal).
#
# Default recipe (running `just`) prints the list.

default:
    @just --list

# Build all binaries in release mode.
build:
    cargo build --release

# Deduplicate a Bitwarden vault export. Without arguments, auto-
# discovers the latest export in vault/ by lexical sort on filename
# (zero-padded UTC timestamps sort chronologically). Two filename
# shapes are accepted:
#   bitwarden_export_<ts>.json            — `bw export --format json`
#   bitwarden_decrypted-export_<ts>.json  — `just backup-vault-decrypted`
# Pass INPUT to override and point at a specific file. OUTPUT / AUDIT
# let you override the default sibling paths (point at /tmp/ or vault/,
# never at examples/).
dedup input='' output='' audit='' split_divergent_totps='' collapse_empty_passwords='':
    #!/usr/bin/env bash
    set -euo pipefail
    input="{{input}}"
    if [[ -z "$input" ]]; then
        if [[ ! -d vault ]]; then
            echo "error: no INPUT given and vault/ directory does not exist" >&2
            echo "hint: mkdir -p vault && mv ~/Downloads/bitwarden_export_*.json vault/" >&2
            echo "      (or run `just backup-vault-decrypted` to write one directly)" >&2
            exit 1
        fi
        input=$({ find vault -maxdepth 1 -type f \
            \( -name 'bitwarden_export_*.json' -o -name 'bitwarden_decrypted-export_*.json' \) \
            ! -name '*.dedup.json' \
            ! -name '*.dedup.audit.json' \
            ! -name '*.dedup.trashed.json' \
            ! -name '*-with-icloud-credentials.json' \
            ! -name '*-with-icloud-credentials.audit.json' \
            ! -name '*-with-icloud-credentials.trashed.json' \
            2>/dev/null || true; } | sort | tail -1)
        if [[ -z "$input" ]]; then
            echo "error: no exportable JSON in vault/" >&2
            echo "hint: mv ~/Downloads/bitwarden_export_*.json vault/" >&2
            echo "      or run `just backup-vault-decrypted` to write one." >&2
            exit 1
        fi
        echo "using latest export: $input" >&2
    fi
    split_flag=""
    case "{{split_divergent_totps}}" in
        1|true|yes|on) split_flag="--split-divergent-totps" ;;
    esac
    epw_flag=""
    case "{{collapse_empty_passwords}}" in
        1|true|yes|on) epw_flag="--collapse-empty-passwords" ;;
    esac
    cargo run --locked --release --bin bitwarden-dedup -- --input "$input" $split_flag $epw_flag {{ if output != "" { "--output " + output } else { "" } }} {{ if audit != "" { "--audit " + audit } else { "" } }}

# Same as `just dedup` but with the safer --split-divergent-totps mode:
# items that differ only in login.totp stay as separate living items
# instead of auto-collapsing by revisionDate.
dedup-split-totps input='' output='' audit='':
    @just dedup "{{input}}" "{{output}}" "{{audit}}" true

# Same as `just dedup` but with --collapse-empty-passwords enabled.
# Runs an additional opt-in dedup pass over credential-less stubs
# (empty `login.password`) that the strict pass deliberately skips.
# Items only group when name + organization + username + URI host set
# + fido2 signature all match AND the group has at least one
# identifying signal (non-empty username, non-empty URI host set, or
# a fido2 credential). See README "Empty-password dedup pass" for the
# full rationale and signal-kind risk classes.
dedup-collapse-empty-passwords input='' output='' audit='':
    @just dedup "{{input}}" "{{output}}" "{{audit}}" "" true

# Merge an Apple Passwords CSV export into a Bitwarden JSON vault.
# Without arguments: picks the newest `bitwarden_export_*.json` or
# `bitwarden_decrypted-export_*.json` and the newest `*-Passwords.csv`
# (or `Passwords*.csv`) in vault/. Writes
# `<bitwarden_stem>-with-icloud-credentials.json` + audit next to the
# Bitwarden input. Dedup losers land in a sidecar
# `<bitwarden_stem>-with-icloud-credentials.trashed.json` — NOT
# auto-imported; offline recovery copy.
merge-with-icloud-credentials-csv bitwarden='' icloud='' output='' audit='' split_divergent_totps='' collapse_empty_passwords='':
    #!/usr/bin/env bash
    set -euo pipefail
    bw="{{bitwarden}}"
    csv="{{icloud}}"
    if [[ -z "$bw" ]]; then
        if [[ ! -d vault ]]; then
            echo "error: no BITWARDEN path given and vault/ directory does not exist" >&2
            exit 1
        fi
        bw=$({ find vault -maxdepth 1 -type f \
            \( -name 'bitwarden_export_*.json' -o -name 'bitwarden_decrypted-export_*.json' \) \
            ! -name '*.dedup.json' \
            ! -name '*.dedup.audit.json' \
            ! -name '*.dedup.trashed.json' \
            ! -name '*-with-icloud-credentials.json' \
            ! -name '*-with-icloud-credentials.audit.json' \
            ! -name '*-with-icloud-credentials.trashed.json' \
            2>/dev/null || true; } | sort | tail -1)
        if [[ -z "$bw" ]]; then
            echo "error: no exportable JSON in vault/" >&2
            exit 1
        fi
        echo "using latest Bitwarden export: $bw" >&2
    fi
    if [[ -z "$csv" ]]; then
        # Apple-Passwords CSV filenames are NOT guaranteed to encode
        # chronology the way Bitwarden export names do, so a lexical
        # sort is unsafe here. Require exactly one match; if there are
        # several, list them and make the operator pick explicitly via
        # `icloud=<path>`.
        matches=$(find vault -maxdepth 1 -type f \
            \( -name '*-Passwords.csv' -o -name '*-passwords.csv' -o -name 'Passwords*.csv' \) \
            2>/dev/null || true)
        count=0
        if [[ -n "$matches" ]]; then
            count=$(printf '%s\n' "$matches" | wc -l | tr -d ' ')
        fi
        if [[ "$count" -eq 0 ]]; then
            echo "error: no Apple Passwords CSV in vault/ (expected e.g. '2026-04-23-Passwords.csv')" >&2
            exit 1
        fi
        if [[ "$count" -gt 1 ]]; then
            echo "error: multiple Apple Passwords CSVs in vault/ — pass icloud=<path> to pick one:" >&2
            printf '%s\n' "$matches" | sed 's/^/  - /' >&2
            exit 1
        fi
        csv="$matches"
        echo "using iCloud CSV:              $csv" >&2
    fi
    split_flag=""
    case "{{split_divergent_totps}}" in
        1|true|yes|on) split_flag="--split-divergent-totps" ;;
    esac
    epw_flag=""
    case "{{collapse_empty_passwords}}" in
        1|true|yes|on) epw_flag="--collapse-empty-passwords" ;;
    esac
    cargo run --locked --release --bin bitwarden-merge-icloud -- \
        --bitwarden "$bw" --icloud "$csv" $split_flag $epw_flag \
        {{ if output != "" { "--output " + output } else { "" } }} \
        {{ if audit != "" { "--audit " + audit } else { "" } }}

# Same as merge-with-icloud-credentials-csv but with the safer
# --split-divergent-totps mode.
merge-with-icloud-credentials-csv-split-totps bitwarden='' icloud='' output='' audit='':
    @just merge-with-icloud-credentials-csv "{{bitwarden}}" "{{icloud}}" "{{output}}" "{{audit}}" true

# Same as merge-with-icloud-credentials-csv but with
# --collapse-empty-passwords enabled. See `just
# dedup-collapse-empty-passwords` for the rationale.
merge-with-icloud-credentials-csv-collapse-empty-passwords bitwarden='' icloud='' output='' audit='':
    @just merge-with-icloud-credentials-csv "{{bitwarden}}" "{{icloud}}" "{{output}}" "{{audit}}" "" true

# Move every item in a Bitwarden export into a single folder. Replaces the
# export's `folders` array with one folder of the given name and rewrites every
# item's `folderId` to point at it. Auto-discovers the latest
# `bitwarden_export_*.json` in vault/ when INPUT is omitted. OUTPUT defaults to
# `<input_stem>.in-folder-<folder>.json` next to the input. The new folder gets
# a fresh v4 UUID; Bitwarden's import re-resolves it by name on the way in, so
# the generated UUID only needs to satisfy the export schema.
#
# Examples:
#   just move-to-folder                       # everything → "main"
#   just move-to-folder archive               # everything → "archive"
#   just move-to-folder main vault/foo.json
move-to-folder folder='main' input='' output='':
    cargo run --locked --release --bin bitwarden-move-to-folder -- \
        --folder "{{folder}}" \
        {{ if input != "" { "--input " + input } else { "" } }} \
        {{ if output != "" { "--output " + output } else { "" } }}

# Run the dedup tool against the committed synthetic example fixture.
# Useful for smoke-testing a build without needing a real vault export.
example:
    ./target/release/bitwarden-dedup --input examples/bitwarden_export_20260411172632.json --output /tmp/example.dedup.json --audit /tmp/example.dedup.audit.json

# Produce a local redacted replica of a real vault export. The output is
# safe to share with a reviewer but is still sensitive enough that it is
# gitignored and MUST be written to `/tmp/` or `vault/`, never to
# `examples/`. Example: `just redact vault/bitwarden_export.json /tmp/redacted.json`
redact input output:
    cargo run --locked --release --bin bitwarden-redact -- --input {{input}} --output {{output}}

# Encrypted backup of the live Bitwarden vault via the REST API.
#
# Authenticates with the personal API key in
# `vault/bitwarden_api_key.env`, fetches `/api/sync`, and writes the
# raw encrypted response to `vault/bitwarden_sync_<UTC-ts>.json`
# (mode 0o600, gitignored). No master password is requested or used;
# the snapshot is encrypted end-to-end and not decryptable by this
# tool. Cron-friendly: no interactive prompt.
#
# Prerequisites:
# - vault/bitwarden_api_key.env populated with BW_CLIENT_ID,
#   BW_CLIENT_SECRET, BW_REGION (us|eu).
#
# For a `just dedup`-ready JSON export, use `just backup-vault-decrypted`.
backup-vault-encrypted:
    cargo run --locked --release --bin bitwarden-backup-vault-encrypted

# Decrypted backup of the live Bitwarden vault via the REST API.
#
# Same network path as `backup-vault-encrypted`, plus:
#   - Prompts for the master password (no echo, never logged).
#   - Derives the master key (Argon2id or PBKDF2 per the account
#     KDF settings on profile in /api/sync).
#   - Decrypts the user key + every cipher field.
#   - Writes a `just dedup`-ready JSON-export-shape file to
#     `vault/bitwarden_export_<UTC-ts>.json` (mode 0o600, gitignored).
#
# **Output is plaintext** — passwords, TOTP seeds, FIDO2 credentials
# in the clear. Same risk profile as `bw export --format json`. The
# vault/ directory is the only at-rest protection.
#
# Crypto correctness is gated on tests/crypto_vectors.rs (byte-locked
# vectors lifted from bitwarden/sdk-internal). If those tests pass,
# this binary decrypts identically to the official Bitwarden client.
#
# Prerequisites:
# - vault/bitwarden_api_key.env populated with BW_CLIENT_ID,
#   BW_CLIENT_SECRET, BW_REGION (us|eu).
# - The master password ready to type at the prompt.
backup-vault-decrypted:
    cargo run --locked --release --bin bitwarden-backup-vault-decrypted

# Regenerate the committed example fixture at examples/example_export.json.
regenerate-example:
    cargo test --test fixture regenerate_example_fixture -- --ignored --nocapture

# Run the full test suite (lib + both binaries + integration + leak-guard).
test:
    cargo test

# Format and lint.
check:
    cargo fmt --check
    cargo clippy --all-targets --all-features -- -D warnings

fmt:
    cargo fmt

# Wipe build artifacts.
clean:
    cargo clean
