# Copyright 2026 Alexander Orlov <alexander.orlov@loxal.net>
#
# bitwarden-dedup — task runner
#
# Two binaries:
#   * bitwarden-dedup   — deduplicate a real export into an import-ready file
#   * bitwarden-redact  — produce a committable redacted replica of a real export
#
# Default recipe (running `just`) prints the list.

default:
    @just --list

# Build both binaries in release mode.
build:
    cargo build --release

# Deduplicate a Bitwarden vault export. Without arguments, auto-
# discovers the latest `bitwarden_export_<timestamp>.json` in vault/
# by lexical sort on the filename (zero-padded YYYYMMDDHHMMSS
# timestamps sort chronologically). Pass INPUT to override and point
# at a specific file. OUTPUT / AUDIT let you override the default
# sibling paths (point at /tmp/ or vault/, never at examples/).
dedup input='' output='' audit='' split_divergent_totps='':
    #!/usr/bin/env bash
    set -euo pipefail
    input="{{input}}"
    if [[ -z "$input" ]]; then
        if [[ ! -d vault ]]; then
            echo "error: no INPUT given and vault/ directory does not exist" >&2
            echo "hint: mkdir -p vault && mv ~/Downloads/bitwarden_export_*.json vault/" >&2
            exit 1
        fi
        input=$({ find vault -maxdepth 1 -type f \
            -name 'bitwarden_export_*.json' \
            ! -name '*.dedup.json' \
            ! -name '*.dedup.audit.json' \
            2>/dev/null || true; } | sort | tail -1)
        if [[ -z "$input" ]]; then
            echo "error: no bitwarden_export_*.json file in vault/" >&2
            echo "hint: mv ~/Downloads/bitwarden_export_*.json vault/" >&2
            exit 1
        fi
        echo "using latest export: $input" >&2
    fi
    split_flag=""
    case "{{split_divergent_totps}}" in
        1|true|yes|on) split_flag="--split-divergent-totps" ;;
    esac
    cargo run --release --bin bitwarden-dedup -- --input "$input" $split_flag {{ if output != "" { "--output " + output } else { "" } }} {{ if audit != "" { "--audit " + audit } else { "" } }}

# Same as `just dedup` but with the safer --split-divergent-totps mode:
# items that differ only in login.totp stay as separate living items
# instead of auto-collapsing by revisionDate. Use this when the item-
# level revisionDate heuristic cannot be trusted for the current vault.
dedup-split-totps input='' output='' audit='':
    @just dedup "{{input}}" "{{output}}" "{{audit}}" true

# Merge an Apple Passwords CSV export into a Bitwarden JSON vault.
# Without arguments: picks the newest `bitwarden_export_*.json` and the
# newest `*-Passwords.csv` (or `Passwords*.csv`) in vault/. Writes
# `<bitwarden_stem>-with-icloud-credentials.json` + audit next to the
# Bitwarden input. Nothing is ever removed — dedup losers get
# `deletedDate` set so they surface in Bitwarden's Trash folder after
# import and can be recovered by hand.
merge-with-icloud-credentials-csv bitwarden='' icloud='' output='' audit='' split_divergent_totps='':
    #!/usr/bin/env bash
    set -euo pipefail
    bw="{{bitwarden}}"
    csv="{{icloud}}"
    if [[ -z "$bw" ]]; then
        if [[ ! -d vault ]]; then
            echo "error: no BITWARDEN path given and vault/ directory does not exist" >&2
            exit 1
        fi
        bw=$({ find vault -maxdepth 1 -type f \
            -name 'bitwarden_export_*.json' \
            ! -name '*.dedup.json' \
            ! -name '*.dedup.audit.json' \
            ! -name '*-with-icloud-credentials.json' \
            ! -name '*-with-icloud-credentials.audit.json' \
            2>/dev/null || true; } | sort | tail -1)
        if [[ -z "$bw" ]]; then
            echo "error: no bitwarden_export_*.json file in vault/" >&2
            exit 1
        fi
        echo "using latest Bitwarden export: $bw" >&2
    fi
    if [[ -z "$csv" ]]; then
        csv=$({ find vault -maxdepth 1 -type f \
            \( -name '*-Passwords.csv' -o -name '*-passwords.csv' -o -name 'Passwords*.csv' \) \
            2>/dev/null || true; } | sort | tail -1)
        if [[ -z "$csv" ]]; then
            echo "error: no Apple Passwords CSV in vault/ (expected e.g. '2026-04-23-Passwords.csv')" >&2
            exit 1
        fi
        echo "using latest iCloud CSV:       $csv" >&2
    fi
    split_flag=""
    case "{{split_divergent_totps}}" in
        1|true|yes|on) split_flag="--split-divergent-totps" ;;
    esac
    cargo run --release --bin bitwarden-merge-icloud -- \
        --bitwarden "$bw" --icloud "$csv" $split_flag \
        {{ if output != "" { "--output " + output } else { "" } }} \
        {{ if audit != "" { "--audit " + audit } else { "" } }}

# Same as merge-with-icloud-credentials-csv but with the safer
# --split-divergent-totps mode. Items that differ only in login.totp
# stay as separate living items (you review and merge by hand later)
# rather than auto-collapsing with a newest-by-revisionDate pick.
merge-with-icloud-credentials-csv-split-totps bitwarden='' icloud='' output='' audit='':
    @just merge-with-icloud-credentials-csv "{{bitwarden}}" "{{icloud}}" "{{output}}" "{{audit}}" true

# Run the dedup tool against the committed synthetic example fixture.
# Useful for smoke-testing a build without needing a real vault export.
example:
    ./target/release/bitwarden-dedup --input examples/bitwarden_export_20260411172632.json --output /tmp/example.dedup.json --audit /tmp/example.dedup.audit.json

# Produce a local redacted replica of a real vault export. The output is
# safe to share with a reviewer: passwords, TOTP seeds, FIDO2 credentials,
# usernames, URIs, notes, custom field values, item ids, folder ids,
# organization metadata, collection ids, and all timestamps are
# synthesized or nulled. Still DO NOT commit this output — the redactor
# output is gitignored and MUST be written to `/tmp/` or `vault/`, never
# to `examples/`. Example: `just redact vault/bitwarden_export.json /tmp/redacted.json`
redact input output:
    cargo run --release --bin bitwarden-redact -- --input {{input}} --output {{output}}

# Regenerate the committed example fixture at examples/example_export.json.
# The fixture is constructed by tests/fixture.rs::build_curated_fixture()
# and contains NO data originating from any real vault.
regenerate-example:
    cargo test --test fixture regenerate_example_fixture -- --ignored --nocapture

# Run the full test suite (lib + both binaries + integration + leak-guard).
test:
    cargo test

# Run only the leak-guard on the committed example fixture.
leak-guard:
    cargo test --test fixture example_fixture_no_leaked_strings

# Format and lint.
check:
    cargo fmt --check
    cargo clippy --all-targets --all-features -- -D warnings

fmt:
    cargo fmt

# Wipe build artifacts.
clean:
    cargo clean
